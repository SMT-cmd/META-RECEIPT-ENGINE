{
  "id": "/receipts",
  "name": "Bizlano Receipts — Find and save receipts",
  "short_name": "My Receipts",
  "description": "Find, recover, save and print receipts from participating businesses.",
  "start_url": "/receipts?source=installed",
  "scope": "/receipts",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#fafaff",
  "theme_color": "#1e2546",
  "categories": [
    "finance",
    "shopping",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Find receipts",
      "short_name": "Receipts",
      "url": "/receipts",
      "icons": [
        {
          "src": "/pwa/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
