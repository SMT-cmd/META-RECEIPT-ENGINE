{
  "id": "/app",
  "name": "Bizlano — Your business, beautifully managed",
  "short_name": "Bizlano",
  "description": "Receipts, invoices, stock, customers and staff in one simple business workspace.",
  "start_url": "/app?source=installed",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#fcfbff",
  "theme_color": "#171c3b",
  "categories": [
    "business",
    "finance",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Business workspace",
      "short_name": "Workspace",
      "url": "/app",
      "icons": [
        {
          "src": "/pwa/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My receipts",
      "short_name": "Receipts",
      "url": "/receipts",
      "icons": [
        {
          "src": "/pwa/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
