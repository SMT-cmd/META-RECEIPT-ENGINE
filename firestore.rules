rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user owns the document (assuming owner_uid field)
    function isOwner() {
      return isAuthenticated() && resource.data.owner_uid == request.auth.uid;
    }

    // 1. Engine Requests (Landing Page Lead Capture)
    // - Public CREATE (anyone can submit a request)
    // - Admin/Creator READ/WRITE (to process requests)
    match /engine_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // 2. Creator History (Social Proof Ticker)
    // - Public READ (for the scrolling wall on landing page)
    // - Authenticated WRITE (to log new partners/docs)
    match /creator_history/{historyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Short URLs (The Branded Engine Configs)
    // - Public READ (so the engine can load the config)
    // - Authenticated CREATE/UPDATE (claiming links)
    match /short_urls/{shortCode} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Allow update if:
      // 1. The doc has no owner (claiming it)
      // 2. The user is the owner
      // 3. Incrementing usage (public update for specific field)
      allow update: if (isAuthenticated() && resource.data.owner_uid == null) || 
                       isOwner() || 
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usage']));

      // Subcollection: Document History for this specific Engine
      // Only the owner of the Engine can read/write its history
      match /receipts/{docId} {
        // Legacy receipts belong to the parent engine, not to the receipt.
        // Preserve the old engine's owner-only history with correct ownership lookup.
        allow read, write: if isAuthenticated()
          && get(/databases/$(database)/documents/short_urls/$(shortCode)).data.owner_uid == request.auth.uid;
      }
    }

    // 4. Notifications (Build requests, system alerts)
    match /notifications/{notifId} {
      allow read, delete: if isAuthenticated();
      allow create: if true; // Public can trigger notifications (e.g. from landing page)
    }

    // 5. User Settings (Signatures, Preferences)
    // - Strictly Owner Only
    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ================================================================
    // MetaForge Business multi-tenant SaaS. Unlike the legacy engine,
    // all workspace records are scoped to a single business and role.
    // ================================================================
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }
    function memberRef(bid) {
      return /databases/$(database)/documents/businesses/$(bid)/members/$(request.auth.uid);
    }
    function businessRef(bid) {
      return /databases/$(database)/documents/businesses/$(bid);
    }
    function inviteRef(bid, inviteId) {
      return /databases/$(database)/documents/businesses/$(bid)/invites/$(inviteId);
    }
    function isBusinessMember(bid) {
      return request.auth != null
        && exists(memberRef(bid))
        && get(memberRef(bid)).data.status == 'active';
    }
    function hasBusinessRole(bid, roles) {
      return isBusinessMember(bid)
        && get(memberRef(bid)).data.role in roles;
    }
    function teamAdmin(bid) {
      return hasBusinessRole(bid, ['owner','admin']);
    }
    function businessEditor(bid) {
      return hasBusinessRole(bid, ['owner','admin','manager','staff']);
    }

    // Slugs are globally unique and reserved atomically with
    // business creation. Expose only the slug-to-ID mapping.
    match /business_slugs/{slug} {
      allow get: if true;
      allow list: if false;
      allow create: if verifiedUser()
        && slug.matches('^[a-z0-9][a-z0-9-]{2,38}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['slug','businessId','ownerUid','createdAt'])
        && request.resource.data.slug == slug
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(businessRef(request.resource.data.businessId)).data.ownerUid == request.auth.uid
        && getAfter(businessRef(request.resource.data.businessId)).data.slug == slug;
      allow update, delete: if false;
    }

    // User-owned business pointers permit safe "My businesses" queries.
    // A pointer alone never grants access: tenant membership controls that.
    match /account_businesses/{userId}/items/{bid} {
      allow get, list: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['businessId','createdAt'])
        && request.resource.data.businessId == bid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/businesses/$(bid)/members/$(userId)).data.status == 'active';
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /businesses/{bid} {
      allow get, list: if isBusinessMember(bid);
      allow create: if verifiedUser()
        && request.resource.data.keys().hasOnly(['ownerUid','slug','name','createdAt','updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/business_slugs/$(request.resource.data.slug)).data.businessId == bid;
      allow update: if hasBusinessRole(bid, ['owner'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /members/{uid} {
        allow get: if isBusinessMember(bid) &&
          (request.auth.uid == uid || teamAdmin(bid));
        allow list: if teamAdmin(bid);
        allow create: if verifiedUser()
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','email','role','status','inviteId','joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'active'
          && request.resource.data.joinedAt == request.time
          && (
            (
              getAfter(businessRef(bid)).data.ownerUid == uid
              && request.resource.data.role == 'owner'
              && request.resource.data.inviteId == ''
            ) || (
              request.resource.data.inviteId is string
              && request.resource.data.inviteId.size() > 15
              && get(inviteRef(bid,request.resource.data.inviteId)).data.email == request.auth.token.email
              && get(inviteRef(bid,request.resource.data.inviteId)).data.expiresAt > request.time
              && getAfter(inviteRef(bid,request.resource.data.inviteId)).data.usedBy == uid
              && get(inviteRef(bid,request.resource.data.inviteId)).data.role == request.resource.data.role
            )
          );
        // Only the owner may adjust member roles/status. Nobody may
        // transfer the business owner role through ordinary client writes.
        allow update: if hasBusinessRole(bid,['owner'])
          && resource.data.role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
          && request.resource.data.role in ['admin','manager','staff','viewer']
          && request.resource.data.status in ['active','suspended'];
        allow delete: if false;
      }

      match /invites/{token} {
        allow get: if teamAdmin(bid)
          || (verifiedUser()
            && resource.data.email == request.auth.token.email);
        allow list: if teamAdmin(bid);
        allow create: if teamAdmin(bid)
          && token.size() >= 20
          && request.resource.data.keys().hasOnly(['email','role','createdBy','createdAt','expiresAt','usedBy','usedAt'])
          && request.resource.data.email is string
          && request.resource.data.email.size() >= 5
          && request.resource.data.email.size() <= 254
          && request.resource.data.role in ['admin','manager','staff','viewer']
          && (request.resource.data.role != 'admin' || hasBusinessRole(bid,['owner']))
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt > request.time
          && request.resource.data.usedBy == null
          && request.resource.data.usedAt == null;
        // The invited, verified email may consume an invitation exactly once.
        allow update: if verifiedUser()
          && resource.data.usedBy == null
          && resource.data.email == request.auth.token.email
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy','usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.usedAt == request.time;
        allow delete: if teamAdmin(bid);
      }

      match /legacy_imports/{sourceId} {
        allow get, list: if hasBusinessRole(bid, ['owner','admin']);
        allow create: if hasBusinessRole(bid, ['owner'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.sourceId == sourceId
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /settings/{settingsId} {
        allow get, list: if isBusinessMember(bid);
        allow create, update: if teamAdmin(bid)
          && settingsId == 'profile'
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120;
        allow delete: if false;
      }
      match /counters/{counterId} {
        allow get: if businessEditor(bid);
        allow list: if false;
        allow create: if businessEditor(bid)
          && request.resource.data.last == 1
          && request.resource.data.prefix is string;
        allow update: if businessEditor(bid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
          && request.resource.data.last == resource.data.last + 1;
        allow delete: if false;
      }
      match /documents/{docId} {
        allow read: if isBusinessMember(bid);
        allow create: if businessEditor(bid)
          && request.resource.data.id == docId
          && request.resource.data.number is string
          && request.resource.data.number.size() <= 65;
        allow update: if businessEditor(bid)
          && resource.data.voided != true
          && request.resource.data.id == docId;
        allow delete: if false;
      }
      match /customers/{customerId} {
        allow read: if isBusinessMember(bid);
        allow create, update: if businessEditor(bid);
        allow delete: if teamAdmin(bid);
      }
      match /products/{productId} {
        allow read: if isBusinessMember(bid);
        allow create, delete: if hasBusinessRole(bid,['owner','admin','manager']);
        allow update: if hasBusinessRole(bid,['owner','admin','manager'])
          || (hasBusinessRole(bid,['staff'])
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock','updatedAt']));
      }
      match /expenses/{expenseId} {
        allow read, write: if teamAdmin(bid);
      }
      match /targets/{monthId} {
        // Business-wide monthly targets (not browser-local preferences).
        // Only authorized managerial roles can change financial goals.
        allow get, list: if isBusinessMember(bid);
        allow create, update: if hasBusinessRole(bid, ['owner','admin','manager'])
          && monthId.matches('^[0-9]{4}-[0-9]{2}
        allow read: if teamAdmin(bid);
        allow create: if isBusinessMember(bid)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // MetaForge multi-business workspaces — isolated by immutable slug.
    // Legacy engine rules above remain unchanged for existing customers.
    // -------------------------------------------------------------------
    function tenantSignedIn() {
      return request.auth != null;
    }
    function tenantVerified() {
      return tenantSignedIn() && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function tenantExists(slug) {
      return exists(/databases/$(database)/documents/tenants/$(slug));
    }
    function tenantOwner(slug) {
      return tenantSignedIn() && tenantExists(slug)
        && get(/databases/$(database)/documents/tenants/$(slug)).data.ownerUid == request.auth.uid;
    }
    function tenantMember(slug) {
      return tenantSignedIn() && exists(/databases/$(database)/documents/tenants/$(slug)/members/$(request.auth.uid));
    }
    function tenantRole(slug) {
      return get(/databases/$(database)/documents/tenants/$(slug)/members/$(request.auth.uid)).data.role;
    }
    function canViewTenant(slug) {
      return tenantOwner(slug) || tenantMember(slug);
    }
    function canManageTenant(slug) {
      return tenantOwner(slug) || (tenantMember(slug) && tenantRole(slug) == 'manager');
    }
    function canWriteTenantDocuments(slug) {
      return tenantOwner(slug) || (tenantMember(slug) && tenantRole(slug) in ['manager','staff']);
    }
    function canJoinViaInvite(slug, memberUid) {
      return tenantVerified() && request.auth.uid == memberUid
        && exists(/databases/$(database)/documents/tenants/$(slug)/invites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/tenants/$(slug)/invites/$(request.auth.token.email.lower())).data.status == 'pending'
        && request.resource.data.uid == memberUid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == get(/databases/$(database)/documents/tenants/$(slug)/invites/$(request.auth.token.email.lower())).data.role
        && request.resource.data.role in ['manager','staff','viewer'];
    }
    function validTenantDocument(slug) {
      return request.resource.data.tenantId == slug
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.type is string
        && request.resource.data.number is string
        && request.resource.data.number.size() <= 100
        && request.resource.data.status in ['draft','issued','void']
        && request.resource.data.currency in ['NGN','USD','GBP','EUR','GHS','KES','ZAR'];
    }

    // Public directory exposes brand identity only, never internal records.
    match /tenant_directory/{slug} {
      allow get, list: if true;
      allow create, update: if tenantOwner(slug)
        && request.resource.data.slug == slug
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow delete: if tenantOwner(slug);
    }
    match /user_spaces/{userId}/brands/{slug} {
      allow get, list: if tenantSignedIn() && request.auth.uid == userId;
      allow create, update: if tenantVerified() && request.auth.uid == userId
        && request.resource.data.slug == slug
        && canViewTenant(slug);
      allow delete: if tenantSignedIn() && request.auth.uid == userId;
    }
    match /tenants/{slug} {
      allow get: if canViewTenant(slug);
      allow list: if false; // never query all private business profiles
      allow create: if tenantVerified() && slug.matches('[a-z0-9][a-z0-9-]{2,39}')
        && !(slug in ['www','app','admin','api','mail','auth','support','billing','help','assets','static','creator','engine'])
        && request.resource.data.slug == slug
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.currency in ['NGN','USD','GBP','EUR','GHS','KES','ZAR'];
      allow update: if tenantOwner(slug)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == resource.data.slug;
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if canManageTenant(slug) || (tenantSignedIn() && request.auth.uid == memberUid);
        allow list: if canManageTenant(slug);
        allow create: if (
           tenantOwner(slug)
             && request.resource.data.uid == memberUid
             && request.resource.data.role in ['owner','manager','staff','viewer']
             && (request.resource.data.role != 'owner'
               || memberUid == request.auth.uid)
          ) || canJoinViaInvite(slug, memberUid);
        allow update: if tenantOwner(slug)
          && memberUid != get(/databases/$(database)/documents/tenants/$(slug)).data.ownerUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['manager','staff','viewer'];
        allow delete: if tenantOwner(slug)
          && memberUid != get(/databases/$(database)/documents/tenants/$(slug)).data.ownerUid;
      }
      match /invites/{emailKey} {
        allow get: if canManageTenant(slug)
          || (tenantVerified() && request.auth.token.email.lower() == emailKey);
        allow list: if canManageTenant(slug);
        allow create: if canManageTenant(slug)
          && request.resource.data.email == emailKey
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['manager','staff','viewer']
          && (tenantOwner(slug) || request.resource.data.role in ['staff','viewer']);
        allow update: if (
          canManageTenant(slug)
            && request.resource.data.email == resource.data.email
            && request.resource.data.role in ['manager','staff','viewer']
            && (tenantOwner(slug) || request.resource.data.role in ['staff','viewer'])
          ) || (
            tenantVerified() && request.auth.token.email.lower() == emailKey
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedUid','acceptedAt'])
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedUid == request.auth.uid
          );
        allow delete: if canManageTenant(slug);
      }
      match /documents/{documentId} {
        allow get, list: if canViewTenant(slug);
        allow create: if canWriteTenantDocuments(slug)
          && validTenantDocument(slug)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canWriteTenantDocuments(slug)
          && validTenantDocument(slug)
          && request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.status != 'void' || canManageTenant(slug));
        allow delete: if false; // immutable history: void, do not destroy
      }
      match /customers/{customerId} {
        allow get, list: if canViewTenant(slug);
        allow create, update: if canWriteTenantDocuments(slug)
          && request.resource.data.tenantId == slug;
        allow delete: if canManageTenant(slug);
      }
      match /products/{productId} {
        allow get, list: if canViewTenant(slug);
        allow create, update: if canManageTenant(slug)
          && request.resource.data.tenantId == slug
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;
        allow delete: if false;
      }
      match /payments/{paymentId} {
        allow get, list: if canViewTenant(slug);
        allow create: if canWriteTenantDocuments(slug)
          && request.resource.data.tenantId == slug
          && request.resource.data.documentId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && exists(/databases/$(database)/documents/tenants/$(slug)/documents/$(request.resource.data.documentId));
        allow update, delete: if false; // payment journal entries are append-only
      }
      match /expenses/{expenseId} {
        allow get, list: if canManageTenant(slug);
        allow create, update: if canManageTenant(slug)
          && request.resource.data.tenantId == slug
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow delete: if false;
      }
      match /counters/{counterId} {
        allow get: if canWriteTenantDocuments(slug);
        allow list: if false;
        allow create, update: if canWriteTenantDocuments(slug)
          && request.resource.data.next is int
          && request.resource.data.next > 0
          && (!exists(/databases/$(database)/documents/tenants/$(slug)/counters/$(counterId))
              || request.resource.data.next == resource.data.next + 1);
        allow delete: if false;
      }
    }

  }
}
)
          && request.resource.data.keys().hasOnly(['month','amount','currency','updatedBy','updatedAt'])
          && request.resource.data.month == monthId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000000000
          && request.resource.data.currency in ['NGN','USD','GBP','EUR','GHS','KES','ZAR']
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /audit/{eventId} {
        allow read: if teamAdmin(bid);
        allow create: if isBusinessMember(bid)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // MetaForge multi-business workspaces — isolated by immutable slug.
    // Legacy engine rules above remain unchanged for existing customers.
    // -------------------------------------------------------------------
    function tenantSignedIn() {
      return request.auth != null;
    }
    function tenantVerified() {
      return tenantSignedIn() && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function tenantExists(slug) {
      return exists(/databases/$(database)/documents/tenants/$(slug));
    }
    function tenantOwner(slug) {
      return tenantSignedIn() && tenantExists(slug)
        && get(/databases/$(database)/documents/tenants/$(slug)).data.ownerUid == request.auth.uid;
    }
    function tenantMember(slug) {
      return tenantSignedIn() && exists(/databases/$(database)/documents/tenants/$(slug)/members/$(request.auth.uid));
    }
    function tenantRole(slug) {
      return get(/databases/$(database)/documents/tenants/$(slug)/members/$(request.auth.uid)).data.role;
    }
    function canViewTenant(slug) {
      return tenantOwner(slug) || tenantMember(slug);
    }
    function canManageTenant(slug) {
      return tenantOwner(slug) || (tenantMember(slug) && tenantRole(slug) == 'manager');
    }
    function canWriteTenantDocuments(slug) {
      return tenantOwner(slug) || (tenantMember(slug) && tenantRole(slug) in ['manager','staff']);
    }
    function canJoinViaInvite(slug, memberUid) {
      return tenantVerified() && request.auth.uid == memberUid
        && exists(/databases/$(database)/documents/tenants/$(slug)/invites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/tenants/$(slug)/invites/$(request.auth.token.email.lower())).data.status == 'pending'
        && request.resource.data.uid == memberUid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.role == get(/databases/$(database)/documents/tenants/$(slug)/invites/$(request.auth.token.email.lower())).data.role
        && request.resource.data.role in ['manager','staff','viewer'];
    }
    function validTenantDocument(slug) {
      return request.resource.data.tenantId == slug
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100
        && request.resource.data.type is string
        && request.resource.data.number is string
        && request.resource.data.number.size() <= 100
        && request.resource.data.status in ['draft','issued','void']
        && request.resource.data.currency in ['NGN','USD','GBP','EUR','GHS','KES','ZAR'];
    }

    // Public directory exposes brand identity only, never internal records.
    match /tenant_directory/{slug} {
      allow get, list: if true;
      allow create, update: if tenantOwner(slug)
        && request.resource.data.slug == slug
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow delete: if tenantOwner(slug);
    }
    match /user_spaces/{userId}/brands/{slug} {
      allow get, list: if tenantSignedIn() && request.auth.uid == userId;
      allow create, update: if tenantVerified() && request.auth.uid == userId
        && request.resource.data.slug == slug
        && canViewTenant(slug);
      allow delete: if tenantSignedIn() && request.auth.uid == userId;
    }
    match /tenants/{slug} {
      allow get: if canViewTenant(slug);
      allow list: if false; // never query all private business profiles
      allow create: if tenantVerified() && slug.matches('[a-z0-9][a-z0-9-]{2,39}')
        && !(slug in ['www','app','admin','api','mail','auth','support','billing','help','assets','static','creator','engine'])
        && request.resource.data.slug == slug
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.currency in ['NGN','USD','GBP','EUR','GHS','KES','ZAR'];
      allow update: if tenantOwner(slug)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.slug == resource.data.slug;
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if canManageTenant(slug) || (tenantSignedIn() && request.auth.uid == memberUid);
        allow list: if canManageTenant(slug);
        allow create: if (
           tenantOwner(slug)
             && request.resource.data.uid == memberUid
             && request.resource.data.role in ['owner','manager','staff','viewer']
             && (request.resource.data.role != 'owner'
               || memberUid == request.auth.uid)
          ) || canJoinViaInvite(slug, memberUid);
        allow update: if tenantOwner(slug)
          && memberUid != get(/databases/$(database)/documents/tenants/$(slug)).data.ownerUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['manager','staff','viewer'];
        allow delete: if tenantOwner(slug)
          && memberUid != get(/databases/$(database)/documents/tenants/$(slug)).data.ownerUid;
      }
      match /invites/{emailKey} {
        allow get: if canManageTenant(slug)
          || (tenantVerified() && request.auth.token.email.lower() == emailKey);
        allow list: if canManageTenant(slug);
        allow create: if canManageTenant(slug)
          && request.resource.data.email == emailKey
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 254
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['manager','staff','viewer']
          && (tenantOwner(slug) || request.resource.data.role in ['staff','viewer']);
        allow update: if (
          canManageTenant(slug)
            && request.resource.data.email == resource.data.email
            && request.resource.data.role in ['manager','staff','viewer']
            && (tenantOwner(slug) || request.resource.data.role in ['staff','viewer'])
          ) || (
            tenantVerified() && request.auth.token.email.lower() == emailKey
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedUid','acceptedAt'])
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedUid == request.auth.uid
          );
        allow delete: if canManageTenant(slug);
      }
      match /documents/{documentId} {
        allow get, list: if canViewTenant(slug);
        allow create: if canWriteTenantDocuments(slug)
          && validTenantDocument(slug)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if canWriteTenantDocuments(slug)
          && validTenantDocument(slug)
          && request.resource.data.createdBy == resource.data.createdBy
          && (request.resource.data.status != 'void' || canManageTenant(slug));
        allow delete: if false; // immutable history: void, do not destroy
      }
      match /customers/{customerId} {
        allow get, list: if canViewTenant(slug);
        allow create, update: if canWriteTenantDocuments(slug)
          && request.resource.data.tenantId == slug;
        allow delete: if canManageTenant(slug);
      }
      match /products/{productId} {
        allow get, list: if canViewTenant(slug);
        allow create, update: if canManageTenant(slug)
          && request.resource.data.tenantId == slug
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;
        allow delete: if false;
      }
      match /payments/{paymentId} {
        allow get, list: if canViewTenant(slug);
        allow create: if canWriteTenantDocuments(slug)
          && request.resource.data.tenantId == slug
          && request.resource.data.documentId is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && exists(/databases/$(database)/documents/tenants/$(slug)/documents/$(request.resource.data.documentId));
        allow update, delete: if false; // payment journal entries are append-only
      }
      match /expenses/{expenseId} {
        allow get, list: if canManageTenant(slug);
        allow create, update: if canManageTenant(slug)
          && request.resource.data.tenantId == slug
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow delete: if false;
      }
      match /counters/{counterId} {
        allow get: if canWriteTenantDocuments(slug);
        allow list: if false;
        allow create, update: if canWriteTenantDocuments(slug)
          && request.resource.data.next is int
          && request.resource.data.next > 0
          && (!exists(/databases/$(database)/documents/tenants/$(slug)/counters/$(counterId))
              || request.resource.data.next == resource.data.next + 1);
        allow delete: if false;
      }
    }

  }
}
